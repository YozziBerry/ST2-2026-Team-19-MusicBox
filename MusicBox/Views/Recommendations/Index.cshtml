@model MusicBox.Models.RecommendationViewModel

@{
    ViewData["Title"] = "Music Recommendations";
}

<h1>Music Recommendations</h1>

<p>Find songs based on your musical preferences.</p>

<form asp-controller="Recommendations"
      asp-action="Index"
      method="post">

    <div class="form-group mb-3">
        <label asp-for="Strategy" class="form-label">
            Recommendation Type
        </label>

        <select asp-for="Strategy" class="form-control">
            <option value="Genre">By Genre</option>
            <option value="Artist">By Artist</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Preference" class="form-label">
            Your Preference
        </label>

        <input asp-for="Preference"
               class="form-control"
               placeholder="Enter a genre or artist..." />
    </div>

    <button type="submit" class="btn btn-primary">
        Get Recommendations
    </button>
</form>

@if (Model.Recommendations != null &&
     Model.Recommendations.Any())
{
    <h2 class="mt-4">Recommended Songs</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Genre</th>
                <th>Release Year</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var song in Model.Recommendations)
            {
                <tr>
                    <td>@song.Title</td>
                    <td>@song.Artist</td>
                    <td>@song.Genre</td>
                    <td>@song.ReleaseYear</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!string.IsNullOrWhiteSpace(Model.Preference))
{
    <p class="mt-3">
        No recommendations found.
    </p>
}

